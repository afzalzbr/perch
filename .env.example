# Postgres
DATABASE_URL=postgres://perch:perch@localhost:5432/perch
# A separate DB for Vitest integration tests
TEST_DATABASE_URL=postgres://perch:perch@localhost:5432/perch_test

# Session cookie signing (iron-session). MUST be at least 32 characters.
SESSION_SECRET=change-me-to-a-random-32-char-plus-string

# Storage adapter: "local" writes to ./uploads/, "s3" uses the AWS SDK
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# S3-compatible storage (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Cloudflare Web Analytics (public page beacon only; leave empty in dev)
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# The creator's local timezone — analytics days are rolled in this zone.
PERCH_TZ=America/Los_Angeles

# Public origin used in meta tags and shareable URLs
PERCH_PUBLIC_ORIGIN=http://localhost:3000
