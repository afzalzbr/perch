    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.633.0",
    "@aws-sdk/s3-request-presigner": "3.633.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neondatabase/serverless": "^1.2.0",
    "@types/ws": "^8.18.2",
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.33.0",
    "https-proxy-agent": "^5.0.1",
    "iron-session": "8.0.3",
    "next": "^16.4.3",
    "pg": "8.13.1",
    "postgres": "3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.6.3",
    "ws": "^8.22.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.24.2",
    "tsx": "4.19.2",
    "vitest": "2.1.4"
  }
